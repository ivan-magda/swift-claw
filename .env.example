# swift-claw — dev/runtime config.
# Copy to ~/.swift-claw/clawd.env, fill in, and chmod 600.
CLAW_TELEGRAM_BOT_TOKEN=123456:replace-with-BotFather-token
CLAW_ALLOWLIST=                 # comma-separated numeric Telegram user IDs, e.g. 12345678
CLAW_STATE_ROOT=                # optional; defaults to ~/.swift-claw
CLAW_POLL_TIMEOUT=30            # long-poll seconds
