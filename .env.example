# swift-claw — dev/runtime config.
# Copy to ~/.swift-claw/clawd.env, fill in, and chmod 600.
#
# NOTE: keep comments on their own lines. systemd's EnvironmentFile treats `#` as a
# comment only at the start of a line — an inline `# ...` after a value becomes part of
# the value and breaks parsing.
# --- SECRETS ---
# Production path: run `clawd secrets seal` once to encrypt these into <stateRoot>/secrets.enc
# (key in <stateRoot>/secret.key, mode 0600 — keep it OUT of your state-root backup boundary), then
# you may remove the plaintext secret lines (CLAW_TELEGRAM_BOT_TOKEN, CLAW_LLM_API_KEY,
# CLAW_SEARCH_API_KEY). If EITHER secrets.enc OR secret.key exists, the encrypted backend is
# REQUIRED (no silent env fallback). Leaving these set uses the warned dev fallback (plaintext
# on disk).
CLAW_TELEGRAM_BOT_TOKEN=123456:replace-with-BotFather-token
# comma-separated numeric Telegram user IDs, e.g. 12345678 (empty is allowed — onboarding still boots)
CLAW_ALLOWLIST=
# optional; defaults to ~/.swift-claw
CLAW_STATE_ROOT=
# long-poll seconds
CLAW_POLL_TIMEOUT=30

# LLM provider. CLAW_LLM_MODEL selects the route:
#   - any plain model value (e.g. claude-sonnet-4-6, gpt-4o, openrouter/openai/gpt-5.4) uses the
#     supported OpenAI-compatible Chat Completions route below (needs CLAW_LLM_BASE_URL);
#   - the exact prefix openai-chatgpt/<model> (e.g. openai-chatgpt/gpt-5.4) uses the ChatGPT
#     subscription route. On that route CLAW_LLM_BASE_URL and CLAW_LLM_API_KEY are UNUSED — the
#     endpoint is fixed and auth comes from `clawd auth login`, not from any variable here. There is
#     NO token environment variable: the credential lives in the encrypted state root, never in env.
#     Get the exact value to paste from `clawd auth login` (see docs/LOCAL_DEV.md). This route is
#     unofficial and vendor-dependent; the OpenAI-compatible route is the supported default.
CLAW_LLM_BASE_URL=https://api.anthropic.com/v1
CLAW_LLM_MODEL=claude-sonnet-4-6
# optional; leave blank for local servers that need no auth. Part of the sealed secrets (see above).
# Not read on the openai-chatgpt/ route.
CLAW_LLM_API_KEY=
# max_tokens field name sent to the provider: max_completion_tokens or max_tokens
CLAW_LLM_MAX_TOKENS_FIELD=
# max output tokens per completion; defaults to 4096
CLAW_LLM_MAX_TOKENS=
# streaming rich drafts: true/on/1 (default) or false/off/0 for blocking complete() fallback
CLAW_LLM_STREAMING=
# how the /schedule parse constrains the provider's JSON reply. Default off (no response_format,
# safe for every provider). Set json_object to force valid JSON, or json_schema to also pin the
# draft shape — but only if your provider/model supports response_format. Many free or local
# models do not, and sending it there makes /schedule fail. Must be off on the openai-chatgpt/
# route (any other value fails config validation there).
CLAW_LLM_STRUCTURED_OUTPUT=

# Tools
# web_search backend (Exa). Optional and part of the sealed secrets (see --- SECRETS --- above):
# leave blank to run without web_search — the tool is simply absent and doctor reports it as info,
# not an error.
CLAW_SEARCH_API_KEY=
# comma-separated CIDRs web_fetch may connect to even though the SSRF blocklist reserves them —
# the opt-in for a fake-IP VPN/proxy pool (e.g. 198.18.0.0/15, or a fake IPv6 range). Blank =
# fully strict. Fetches refused inside 198.18.0.0/15 are also auto-allowed without this key when
# a fresh DNS canary probe confirms fake-IP mode; set it only for non-default pools.
CLAW_WEBFETCH_EXEMPT_CIDRS=

# Sandboxed code execution (macOS 26 arm64 only). Disabled by default. Enabling it is the only
# line you need — every other CLAW_EXEC_* default lives in ExecConfig, not here. Uncomment a line
# below only to override its built-in default.
CLAW_EXEC_ENABLED=false
# Override the built-in release-verified image pin (see docs/LOCAL_DEV.md). Must be a
# digest-pinned reference from the registry allowlist; an invalid value fails config load.
# CLAW_EXEC_IMAGE=
# Comma-separated lowercase registry hosts. Default: cgr.dev
# CLAW_EXEC_IMAGE_REGISTRIES=cgr.dev
# Memory cap, 256..8192 MiB. Default: 1024
# CLAW_EXEC_MEMORY_MIB=1024
# CPUs, >=1 and <= host CPUs when enabled. Default: 4
# CLAW_EXEC_CPUS=4
# Guest program budget in seconds, 1..300. Default: 30
# CLAW_EXEC_TIMEOUT=30
# Second switch for full sandbox network egress. Default: false
# CLAW_EXEC_ALLOW_EGRESS=false

# Telegram voice-message transcription (macOS 26 only, on-device via Apple SpeechAnalyzer).
# Enabled by default; set false to opt out. First use of a locale downloads its speech model
# (network needed once); transcription itself is offline. On Linux/older macOS the flag is
# inert — voice messages get the canned "can't read voice messages yet" reply.
# CLAW_VOICE_TRANSCRIPTION=true
# Comma-separated BCP-47 locales in priority order (no audio-language auto-detection exists:
# every configured locale transcribes the note and the most confident transcript wins).
# Default: en-US
# CLAW_VOICE_LOCALES=ru-RU,en-US

# Agentic loop bounds (optional; omit to use built-in defaults). Per run: max LLM round-trips and
# max total tool calls.
CLAW_MAX_TURNS=
CLAW_MAX_TOOL_CALLS=

# Spend budget overrides (optional; omit to use built-in defaults)
CLAW_PER_RUN_USD=
CLAW_PER_DAY_USD=
CLAW_REFERENCE_USD_PER_TOKEN=
CLAW_DAY_TOKEN_CEILING=

# Scheduler & proactive
# IANA timezone for schedule defaults and the heartbeat day boundary; blank = the host's zone
CLAW_TIMEZONE=
# misfires older than this many minutes are skipped, never caught up (>= 1; default 30)
CLAW_SCHED_CATCHUP_MAX_AGE_MINUTES=
# floor for every-N-minutes schedules, in minutes (>= 1; default 5)
CLAW_SCHED_MIN_INTERVAL_MINUTES=
# nested daily budget for scheduled + heartbeat runs, in USD (> 0; default 2.00)
CLAW_PROACTIVE_PER_DAY_USD=
# opt-in heartbeat: true/on/1 or false/off/0 (default off)
CLAW_HEARTBEAT_ENABLED=
# minutes between heartbeats (>= 15; default 60)
CLAW_HEARTBEAT_INTERVAL_MINUTES=
# HH:MM-HH:MM in CLAW_TIMEZONE; may cross midnight; start must differ from end (default 22:00-09:00)
CLAW_HEARTBEAT_QUIET_HOURS=
# max heartbeats per day (>= 1; default 8)
CLAW_HEARTBEAT_MAX_PER_DAY=

# Approvals
# seconds a pending tool approval stays live before auto-deny (60..86400; default 3600)
CLAW_APPROVAL_EXPIRY=
