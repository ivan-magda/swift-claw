{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swift-claw.local/scheduled-task-learning/page-change/conformance-receipt.schema.json",
  "title": "PageChangeConformanceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conformance_id",
    "corpus_sha256",
    "passed",
    "total",
    "coverage",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "conformance_id": {"type": "string", "pattern": "^conformance-[0-9a-f]{12}$"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "passed": {"const": 24},
    "total": {"const": 24},
    "coverage": {"type": "object"},
    "results": {"type": "array", "minItems": 24, "maxItems": 24}
  }
}
