{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swift-claw.local/scheduled-task-learning/page-change/active-lesson-set.schema.json",
  "title": "PageChangeActiveLessonSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_set_id", "lessons"],
  "properties": {
    "schema_version": {"const": 1},
    "lesson_set_id": {"type": "string", "pattern": "^set-[0-9a-f]{12}$"},
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lesson_id", "target_class", "text"],
        "properties": {
          "lesson_id": {"type": "string", "pattern": "^lesson-[0-9a-f]{12}$"},
          "target_class": {
            "enum": [
              "noise.volatile_value",
              "noise.time_or_build_metadata",
              "noise.structure_or_order"
            ]
          },
          "text": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    }
  }
}
