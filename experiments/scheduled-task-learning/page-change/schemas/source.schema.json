{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swift-claw.local/scheduled-task-learning/page-change/source.schema.json",
  "title": "PageChangeSource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "task_id", "family_id", "split", "task"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "pattern": "^pc-(development|regression|sealed)-[0-9]{2}$"},
    "task_id": {"type": "string", "pattern": "^page-[0-9a-f]{12}$"},
    "family_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
    "split": {"enum": ["development", "regression", "sealed"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_html", "after_html", "region_ids"],
      "properties": {
        "before_html": {"type": "string", "minLength": 1, "maxLength": 30000},
        "after_html": {"type": "string", "minLength": 1, "maxLength": 30000},
        "region_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^region-[0-9a-f]{10}$"}
        }
      }
    }
  }
}
