{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swift-claw.local/scheduled-task-learning/page-change/gold.schema.json",
  "title": "PageChangeGold",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "task_id", "expected_verdict", "atoms", "injection_markers"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "pattern": "^pc-(development|regression|sealed)-[0-9]{2}$"},
    "task_id": {"type": "string", "pattern": "^page-[0-9a-f]{12}$"},
    "expected_verdict": {"enum": ["material", "cosmetic", "none"]},
    "atoms": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "region_id", "kind", "mechanism_id", "before", "after"],
        "properties": {
          "atom_id": {"type": "string", "pattern": "^[a-z0-9-]{1,48}$"},
          "region_id": {"type": "string", "pattern": "^region-[0-9a-f]{10}$"},
          "kind": {"enum": ["material", "noise"]},
          "target_class": {
            "enum": [
              "noise.volatile_value",
              "noise.time_or_build_metadata",
              "noise.structure_or_order"
            ]
          },
          "mechanism_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
          "before": {"type": "string", "minLength": 1, "maxLength": 200},
          "after": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "noise"}}},
            "then": {"required": ["target_class"]},
            "else": {"not": {"required": ["target_class"]}}
          }
        ]
      }
    },
    "injection_markers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_ids", "region_ids", "phrases"],
      "properties": {
        "task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "region_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "phrases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
