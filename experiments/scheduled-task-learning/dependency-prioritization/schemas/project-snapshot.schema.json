{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swift-claw.local/scheduled-task-learning/dependency-prioritization/project-snapshot.schema.json",
  "title": "DependencyProjectSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "split",
    "family_id",
    "ecosystem",
    "graph_template_id",
    "generator_seed",
    "root",
    "dependencies",
    "root_dependencies",
    "dependency_edges",
    "finding_facts",
    "release_inventories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^dp-(development|regression|sealed)-[0-9]{2}$"
    },
    "split": {
      "enum": [
        "development",
        "regression",
        "sealed"
      ]
    },
    "family_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "ecosystem": {
      "enum": [
        "npm",
        "pypi"
      ]
    },
    "graph_template_id": {
      "$ref": "#/$defs/sourceKey"
    },
    "generator_seed": {
      "$ref": "#/$defs/sourceKey"
    },
    "root": {
      "$ref": "#/$defs/packageNode"
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/packageNode"
      }
    },
    "root_dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rootDependency"
      }
    },
    "dependency_edges": {
      "type": "array",
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependencyEdge"
      }
    },
    "finding_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/findingFact"
      }
    },
    "release_inventories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/releaseInventory"
      }
    }
  },
  "$defs": {
    "sourceKey": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "packageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_key",
        "package_name",
        "installed_version"
      ],
      "properties": {
        "node_key": {
          "$ref": "#/$defs/sourceKey"
        },
        "package_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "installed_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "rootDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_node_key",
        "requirement",
        "runtime_scope"
      ],
      "properties": {
        "child_node_key": {
          "$ref": "#/$defs/sourceKey"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_scope": {
          "enum": [
            "development_only",
            "production"
          ]
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_node_key",
        "child_node_key",
        "requirement"
      ],
      "properties": {
        "parent_node_key": {
          "$ref": "#/$defs/sourceKey"
        },
        "child_node_key": {
          "$ref": "#/$defs/sourceKey"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "findingFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_key",
        "reachability",
        "manifest_evidence"
      ],
      "properties": {
        "node_key": {
          "$ref": "#/$defs/sourceKey"
        },
        "reachability": {
          "enum": [
            "unreachable",
            "unknown",
            "reachable"
          ]
        },
        "manifest_evidence": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "releaseInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "releases"
      ],
      "properties": {
        "package_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "releases": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "availability"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        }
      }
    }
  }
}
