{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swift-claw.local/scheduled-task-learning/scheduled-learning-v1/task-carrier.schema.json",
  "title": "ScheduledLearningV1TaskCarrier",
  "description": "The closed input.json every M3 task-attempt process reads. Produced by materialize_task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task", "active_lessons"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^page-[0-9a-f]{12}$" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_html", "after_html", "region_ids"],
      "properties": {
        "before_html": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "after_html": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "region_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^region-[0-9a-f]{10}$" }
        }
      }
    },
    "active_lessons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "lessons"],
      "properties": {
        "schema_version": { "const": 1 },
        "lessons": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    }
  }
}
