# Final layout owners that supplement Apple swift-format (ARCHITECTURE.md §19.2).
--rules blankLinesBetweenScopes,trailingCommas,trailingSpace,wrapAttributes,wrapGuardStatementBodies,wrapIfStatementBodies,wrapLoopBodies,wrapCaseBodies,wrapFunctionBodies,wrapPropertyBodies,wrap,wrapArguments
--indent 2
--linebreaks lf
--swift-version 6.3
--trailing-commas collections-only
--func-attributes prev-line
--type-attributes prev-line
--stored-var-attributes prev-line
--computed-var-attributes prev-line
--max-width 100
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-conditions after-first
--wrap-return-type never
--allow-partial-wrapping false
--indent-strings false
--wrap-string-interpolation preserve
